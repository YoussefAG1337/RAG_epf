# Copy to .env and fill in GEMINI_API_KEY before starting the stack.
POSTGRES_DB=course_rag
POSTGRES_USER=course_rag
POSTGRES_PASSWORD=local-development-only
DATABASE_HOST=localhost
# Change if another PostgreSQL already uses 5432 on this machine (Docker publishes this port).
DATABASE_PORT=5432
# Course files: <course>/<file> or <subject>/<course>/<file>; relative to the repository root.
PDF_SOURCE_DIR=data/course-pdfs

# Embeddings run locally in the "embeddings" container (no API, no quota).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Where the ingestion command (run on this machine) reaches the embeddings container.
EMBEDDING_URL=http://localhost:8081
# Hugging Face cache shared with the container, so models download only once.
HF_CACHE_DIR=~/.cache/huggingface

# Answers are written by Gemini ("deterministic" returns the best excerpt, offline).
ANSWER_PROVIDER=gemini
GEMINI_API_KEY=
ANSWER_MODEL=gemini-3.8-flash
# Tried in order when the answer model is overloaded or rate limited; empty disables.
ANSWER_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

RETRIEVAL_LIMIT=8
# Leave empty for the model's measured default (see README).
EVIDENCE_MINIMUM_SCORE=
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

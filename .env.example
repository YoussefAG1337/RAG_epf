# Local-only development defaults. Copy to .env before starting the stack.
POSTGRES_DB=course_rag
POSTGRES_USER=course_rag
POSTGRES_PASSWORD=local-development-only
DATABASE_HOST=localhost
# Change (with the database port mapping in compose.yaml) if another PostgreSQL uses 5432.
DATABASE_PORT=5432
PDF_SOURCE_DIR=data/course-pdfs
GEMINI_API_KEY=
RAG_PROVIDER=deterministic
ANSWER_MODEL=gemini-3.8-flash
# Tried in order when the answer model is overloaded or rate limited; empty disables.
ANSWER_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RETRIEVAL_LIMIT=8
# Leave empty for the provider default (0.6 for gemini, 0.1 for deterministic).
EVIDENCE_MINIMUM_SCORE=
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

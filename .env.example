# Local-only development defaults. Copy to .env before starting the stack.
POSTGRES_DB=course_rag
POSTGRES_USER=course_rag
POSTGRES_PASSWORD=local-development-only
DATABASE_HOST=localhost
PDF_SOURCE_DIR=data/course-pdfs
GEMINI_API_KEY=
RAG_PROVIDER=deterministic
ANSWER_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RETRIEVAL_LIMIT=8
EVIDENCE_MINIMUM_SCORE=0.35
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
